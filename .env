VITE_WHITELABEL=hm
VITE_THEME=dark

### Data Strategy
# Options: "api" | "mock"
VITE_DATA_STRATEGY=mock

# Mock Data Strategy (only if VITE_DATA_STRATEGY=mock)
# Options: "static" | "fakerjs" | "msw"
VITE_DATA_MOCK_STRATEGY=msw

# Base URL for Data API calls (if strategy=api or mock_strategy=msw)
VITE_API_BASE_URL=https://api.devex-analytics.com


### Theme Strategy
# Options: "api" | "mock"
VITE_THEME_SOURCE=mock

# Mock Theme Strategy (only if VITE_THEME_SOURCE=mock)
# Options: "static" | "msw"
VITE_THEME_MOCK_STRATEGY=static

# Base URL for API Theme calls (if source=api)
VITE_THEME_API_URL=https://api.devex-analytics.com/theme/v1/
